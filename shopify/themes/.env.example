# Copy to .env (gitignored) and fill in. Theme Access passwords only — no other
# credentials belong here.
#
# Generate each one from the Theme Access app installed on that store:
#   Apps > Theme Access > Create password. The password is emailed to the
#   address given; it is scoped to theme read/write on that store only.

# lush-qatar.myshopify.com — build/live/vanilla environments
QA_THEME_TOKEN=shptka_

# KSA store, ckdthc-qn.myshopify.com (lush.sa.com) — reference only. The wrapper
# never pushes with this. Note the randomized store handle.
KSA_THEME_TOKEN=shptka_
